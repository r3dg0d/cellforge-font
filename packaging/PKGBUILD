# Maintainer: Vincent Patrick Chambers <192937334+r3dg0d@users.noreply.github.com>
# Installs the prebuilt v1.000 release archive.
pkgname=ttf-cellforge
pkgver=1.000
pkgrel=1
pkgdesc="An original pixel-grid type family: 9 weights × upright and pixel-step italic, built procedurally from hand-drawn pixel maps."
arch=(any)
url="https://github.com/r3dg0d/cellforge-font"
license=(OFL-1.1)
source=("$url/releases/download/v$pkgver/Cellforge-v$pkgver.zip")
sha256sums=('4810558581a2d66613e5da305e774a25c7021f55398146ecfc6c9a8b65785603')

package() {
  cd "Cellforge-v$pkgver"
  install -Dm644 -t "$pkgdir/usr/share/fonts/TTF" ttf/*.ttf variable/*.ttf
  install -Dm644 -t "$pkgdir/usr/share/fonts/OTF" otf/*.otf
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
